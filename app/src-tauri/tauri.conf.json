{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Shotloop",
  "version": "0.1.0",
  "identifier": "dev.oliverz.shotloop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1437",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Shotloop",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 18,
          "y": 22
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob: https:; media-src 'self' asset: http://asset.localhost blob:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [],
          "deny": [],
          "requireLiteralLeadingDot": false
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "category": "Video",
    "shortDescription": "Fix one shot, not the whole film.",
    "copyright": "Copyright 2026 Oliver Zhang. Licensed under the Apache License 2.0.",
    "license": "Apache-2.0",
    "licenseFile": "../../LICENSE"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY5OTc5RjlGMjNENjA5Q0MKUldUTUNkWWpuNStYK2NJS2VGdVcvQ2VUaVh6aXlpdFB2d3V2ZmtwTVFxdDMzSEpUNlJveU43ajkK",
      "endpoints": [
        "https://github.com/chihyungchang/Shotloop/releases/latest/download/latest.json"
      ]
    }
  }
}
