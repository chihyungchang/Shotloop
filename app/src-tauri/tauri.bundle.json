{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "beforeBuildCommand": "node scripts/sidecars.mjs && node scripts/resources.mjs && pnpm build"
  },
  "bundle": {
    "externalBin": [
      "binaries/node",
      "binaries/ffmpeg"
    ],
    "resources": {
      "bundle-resources/engine/": "engine/",
      "bundle-resources/agent/": "agent/",
      "bundle-resources/examples/": "examples/"
    },
    "createUpdaterArtifacts": true,
    "macOS": {
      "signingIdentity": "-",
      "hardenedRuntime": false
    }
  }
}
