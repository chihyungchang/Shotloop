{
  "name": "shotloop",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.18",
    "pnpm": ">=10"
  },
  "scripts": {
    "record": "node engine/video/record.mjs",
    "blender": "node engine/video/blender.mjs",
    "music": "node engine/video/music.mjs",
    "shotloop": "node engine/shotloop/cli.mjs",
    "app": "pnpm --filter @shotloop/app tauri dev",
    "app:build": "pnpm --filter @shotloop/app tauri build --config src-tauri/tauri.bundle.json --bundles app && node app/scripts/dmg.mjs",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "three": "^0.186.1"
  },
  "packageManager": "pnpm@10.28.2"
}
